[Unit]
Description=iDotMatrix wall panel gallery/control/scheduler
After=network.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=claude
WorkingDirectory=/home/claude/idotmatrix-ha/wallboard
Environment=WALLBOARD_PORT=8080
ExecStart=/home/claude/idotmatrix-ha/wallboard/.venv/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
