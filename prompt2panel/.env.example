# prompt2panel config — copy to .env and fill in. Nothing here is committed.
ANTHROPIC_API_KEY=sk-ant-...
P2P_MODEL=claude-sonnet-5
P2P_MAX_REPAIR=3

# the panel driver (idm-panel-api container) — brain talks to hands over HTTP
IDM_API_URL=http://bt.local:8080
IDM_PANEL=big

# where generated gifs/previews are cached (also feeds the TFT browser later)
P2P_WORK_DIR=~/prompt2panel-out

# Signal (signal-cli daemon)
SIGNAL_ACCOUNT=+15551234567
SIGNAL_CLI_RPC=http://127.0.0.1:8081/api/v1/rpc
